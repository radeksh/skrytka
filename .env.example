# Port and interface the HTTP server listens on
PORT=3000
HOST=0.0.0.0

# SQLite database path (directory is created automatically)
DB_PATH=./data/skrytka.db

# Optional application level allowlist for /create and /api/create.
# Leave empty when the restriction is enforced by the reverse proxy or ingress.
# Comma separated CIDRs or single addresses.
CREATE_ALLOWED_CIDRS=

# Trusted reverse proxies whose X-Forwarded-For header is honoured.
# Leave empty to ignore the header entirely. A boolean value is rejected.
# Example for a proxy on the same host: 127.0.0.1/32,::1/128
# Example for k3s pod network: 10.42.0.0/16
TRUST_PROXY=

# Maximum plaintext size in bytes the client may encrypt
MAX_NOTE_BYTES=65536

# Maximum attachment size in bytes (0 disables attachments)
MAX_UPLOAD_BYTES=10485760

# Hard cap on the total size of stored attachments; uploads fail with 507 above it
FILE_QUOTA_BYTES=5368709120

# Directory for encrypted attachments (default: "files" next to the database)
FILES_DIR=

# How often expired notes are purged
CLEANUP_INTERVAL_MS=60000

# fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
