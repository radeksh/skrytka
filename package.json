{
  "name": "skrytka",
  "version": "0.1.0",
  "description": "Secret note service with end-to-end encryption in the browser",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch --env-file=.env server/index.js",
    "test": "node --test test/*.test.js",
    "dev:worker": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.4",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.131.2"
  }
}
