{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skrytka",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skrytka",
      "database_id": "48eaaf25-9497-4dee-8413-13be24729b2d",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "skrytka-files" }
  ],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "routes": [
    { "pattern": "skrytka.radek.sh", "custom_domain": true }
  ],
  "vars": {
    "MAX_NOTE_BYTES": "65536",
    "MAX_UPLOAD_BYTES": "10485760",
    "FILE_QUOTA_BYTES": "5368709120"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
